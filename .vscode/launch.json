{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPYCACHEPREFIX": "${workspaceFolder}/__pycache__"
            },
            "args": [
                "--exports"
            ],
        },
        {
            "name": "Simulator",
            "type": "debugpy",
            "request": "launch",
            "module": "gui",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPYCACHEPREFIX": "${workspaceFolder}/__pycache__"
            },
            "args": [
                "-w",
                "${workspaceFolder}",
                "--device","127.0.0.1","--simulator"
            ],
            "justMyCode": false
        },
        {
            "name": "Over WiFi",
            "type": "debugpy",
            "request": "launch",
            "module": "gui",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPYCACHEPREFIX": "${workspaceFolder}/__pycache__"
            },
            "args": [
                "-w",
                "${workspaceFolder}",
                "--device","192.168.4.1"
            ],
            "justMyCode": false
        },
        {
            "name": "Runtime",
            "type": "debugpy",
            "request": "launch",
            "module": "gui",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPYCACHEPREFIX": "${workspaceFolder}/__pycache__"
            },
            "args": [
                "-w",
                "${workspaceFolder}",
            ],
            "justMyCode": false
        }

    ]
}