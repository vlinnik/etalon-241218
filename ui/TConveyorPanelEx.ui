	padding: 4px;
	color: darkGray;
	font-weight: bold;
}
QPushButton:flat
{
	border: 1px solid gray;
	border-radius: 4px;
	color: lightGray;
}
QPushButton:flat:hover
{
	background-color: gray;
}
QPushButton:flat:pressed:hover,QPushButton:flat:checked:hover,QPushButton:flat:checked
{
	background-color: green;
}
#more
{
	color: lightGray;
	font-size: 9pt;
	border: none;
	background: none;
}
#more::indicator:unchecked 
